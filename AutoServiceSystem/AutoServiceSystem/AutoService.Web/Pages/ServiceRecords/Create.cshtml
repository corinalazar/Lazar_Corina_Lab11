@page
@model AutoService.Web.Pages.ServiceRecords.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>ServiceRecord</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ServiceRecord.AppointmentId" class="control-label"></label>
                <select asp-for="ServiceRecord.AppointmentId" class ="form-control" asp-items="ViewBag.AppointmentId" ></select>
            </div>
            <div class="form-group">
                <label asp-for="ServiceRecord.ServiceId" class="control-label"></label>
                <select asp-for="ServiceRecord.ServiceId" class ="form-control" asp-items="ViewBag.ServiceId" ></select>
            </div>
            <div class="form-group">
                <label asp-for="ServiceRecord.Notes" class="control-label"></label>
                <input asp-for="ServiceRecord.Notes" class="form-control" />
                <span asp-validation-for="ServiceRecord.Notes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
