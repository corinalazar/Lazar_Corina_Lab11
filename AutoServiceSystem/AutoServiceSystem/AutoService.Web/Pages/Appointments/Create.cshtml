@page
@model AutoService.Web.Pages.Appointments.CreateModel

<h1>Create Appointment</h1>

<form method="post">

    <div class="form-group">
        <label asp-for="Appointment.Date"></label>
        <input asp-for="Appointment.Date" class="form-control" type="datetime-local" />
    </div>

    <div class="form-group">
        <label asp-for="Appointment.VehicleId">Vehicle</label>
        <select asp-for="Appointment.VehicleId"
                asp-items="Model.VehiclesList"
                class="form-control">
            <option value="">Select vehicle</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>

</form>
